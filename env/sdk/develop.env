# TornadoVM upstream `develop`, cloned and built from source into vendor/tornadovm.
#
#   git clone --branch develop https://github.com/beehive-lab/TornadoVM.git vendor/tornadovm
#   cd vendor/tornadovm && make jdk22plus BACKEND=cuda
#
# THIS REPLACES THE `feat/cutile` FEATURE-BRANCH PIN. PR #1083 is merged: the tile
# merge commit ec970e26d is an ancestor of upstream develop, so the tile demos no
# longer need a personal branch. Two constraints disappear with it:
#
#   - the old pin was a jdk21-dev build, so the tile demos compiled with
#     `--release 21 --enable-preview` and ran on JDK 21 only. develop is a
#     jdk22plus build: no preview flags, same JDK 25 as every other demo.
#   - one runner now covers every demo, instead of a separate run-cutile-demos.sh
#     with a hand-set TORNADOVM_HOME.
#
# Verified 2026-09-18: demos 19-22 compile with no preview flags and run green on
# this profile (results/raw/35-develop-cutile-baseline/).

TORNADO_SDK_KIND=local-build
TORNADO_BUILD_DIR=vendor/tornadovm
JDK_SDKMAN_CANDIDATE=25.0.2-open

TORNADO_VERSION=6.1.1-jdk22plus-dev
TORNADO_SHA=8d592d6fbaafe42d66e1e22c27057cb1cdcf9097
TORNADO_TILE_MERGE_COMMIT=ec970e26d
TORNADO_BACKEND=cuda

# The tile path drives nvcc (not NVRTC) and needs CUDA Toolkit >= 13.3:
# CUDATileCompiler.MINIMUM_TOOLKIT = 13003. A userspace install is enough:
#
#   pip install --user nvidia-cuda-nvcc 'cuda-tile[tileiras]' nvidia-cuda-cccl
#
# nvcc spawns `tileiras` by bare name, so setup-env.sh puts this bin dir on PATH.
TORNADO_HAS_TILE_API=1
TORNADO_MIN_CUDA_TOOLKIT=13003
TORNADO_NVCC=$HOME/.local/lib/python3.11/site-packages/nvidia/cu13/bin/nvcc
TORNADO_JAVAC_FLAGS=
TORNADO_JVM_FLAGS=
