# TornadoVM 6.0.0 - the released CUDA SDK, installed from SDKMAN.
#
#   sdk install java 25.0.2-open
#   sdk install tornadovm 6.0.0-jdk22plus-cuda
#
# This is the profile batches 18-34 were captured against. It has NO tile API, so
# demos 19-24 report SKIPPED_REQUIREMENT here.
#
# 6.0.0 ships two CUDA SDKs. `6.0.0-jdk21-cuda` is compiled with JDK 21 preview
# features and runs on JDK 21 *only*. `6.0.0-jdk22plus-cuda` is the non-preview
# build and is the one pinned here.

TORNADO_SDK_KIND=sdkman
TORNADO_SDKMAN_CANDIDATE=6.0.0-jdk22plus-cuda
JDK_SDKMAN_CANDIDATE=25.0.2-open

TORNADO_VERSION=6.0.0
TORNADO_RELEASE_COMMIT=fadb20b
TORNADO_BACKEND=cuda

TORNADO_HAS_TILE_API=0
TORNADO_MIN_CUDA_TOOLKIT=0
TORNADO_NVCC=
TORNADO_JAVAC_FLAGS=
TORNADO_JVM_FLAGS=
