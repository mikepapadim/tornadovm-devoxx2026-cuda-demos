# TornadoVM 7.0.0 - the released CUDA SDK, installed from SDKMAN. The default profile.
#
#   sdk install java 25.0.2-open
#   sdk install tornadovm 7.0.0-jdk22plus-cuda
#
# The first release that ships the CUDA Tile API: PR #1083 (the tile work the
# `develop` profile existed for) is an ancestor of tag v7.0.0, and every class demos
# 19-24 import (uk.ac.manchester.tornado.api.tile.*) is in tornado-api-7.0.0.jar.
# Also carries #1066 (payload alignment) and #1079 (global-load batching, default on).
#
# 7.0.0 ships two CUDA SDKs. `7.0.0-jdk21-cuda` is compiled with JDK 21 preview
# features and runs on JDK 21 *only*. `7.0.0-jdk22plus-cuda` is the non-preview
# build and is the one pinned here.
#
# Evidence: results/raw/33-tornadovm-7-migration/ onward.

TORNADO_SDK_KIND=sdkman
TORNADO_SDKMAN_CANDIDATE=7.0.0-jdk22plus-cuda
JDK_SDKMAN_CANDIDATE=25.0.2-open

TORNADO_VERSION=7.0.0
TORNADO_RELEASE_COMMIT=65eb834
TORNADO_BACKEND=cuda

# The tile path drives nvcc (not NVRTC) and needs CUDA Toolkit >= 13.3. A userspace
# install is enough -- see env/sdk/develop.env. On the sm_89 box the wheel lives under
# python3.10; adjust the path on a machine whose pip uses another Python.
TORNADO_HAS_TILE_API=1
TORNADO_MIN_CUDA_TOOLKIT=13003
TORNADO_NVCC=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/bin/nvcc
TORNADO_JAVAC_FLAGS=
TORNADO_JVM_FLAGS=

# lib/libtornado-cutlass.so in this SDK links libcudart.so.13. On a CUDA 12.x box,
# demos 12, 17 and 18 abort at their CUTLASS task unless a CUDA 13 runtime is on the
# loader path. The same pip wheel provides it.
TORNADO_LD_LIBRARY_PATH=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/lib
