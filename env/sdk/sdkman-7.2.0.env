# TornadoVM 7.2.0 - the released CUDA SDK, installed from SDKMAN. The default profile
# since 2026-10-07.
#
#   sdk install java 25.0.2-open
#   sdk install tornadovm 7.2.0-jdk22plus-cuda
#
# Same capabilities as 7.0.0 (CUDA Tile API included), plus 7.1.0 (tornado-cuvs) and
# 7.2.0 (#1194 rolled tile k-loops, #1195 KernelContext mmaLoadA/B from HalfFloatArray,
# #1182 --ea fix). See $TORNADOVM_HOME/CHANGELOG.rst.
#
# 7.2.0 ships two CUDA SDKs. `7.2.0-jdk21-cuda` is compiled with JDK 21 preview
# features and runs on JDK 21 *only*. `7.2.0-jdk22plus-cuda` is the non-preview
# build (etc/tornado.jdk: floor=22, preview=false) and is the one pinned here.
#
# Evidence: results/raw/51-tornadovm-7.2.0-migration/.

TORNADO_SDK_KIND=sdkman
TORNADO_SDKMAN_CANDIDATE=7.2.0-jdk22plus-cuda
JDK_SDKMAN_CANDIDATE=25.0.2-open

TORNADO_VERSION=7.2.0
TORNADO_RELEASE_COMMIT=87a465f
TORNADO_BACKEND=cuda

TORNADO_HAS_TILE_API=1
# KernelContext.mmaLoadA/mmaLoadB from a global HalfFloatArray (#1195, new in 7.2.0): demo 31
TORNADO_HAS_MMA_GLOBAL_LOAD=1
TORNADO_MIN_CUDA_TOOLKIT=13003
TORNADO_NVCC=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/bin/nvcc
TORNADO_JAVAC_FLAGS=
TORNADO_JVM_FLAGS=

# lib/libtornado-cutlass.so still links libcudart.so.13 (checked with ldd), so the
# CUDA 13 runtime from the pip wheel stays on the loader path, as for 7.0.0.
TORNADO_LD_LIBRARY_PATH=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/lib
