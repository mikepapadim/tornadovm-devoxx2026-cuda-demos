# Pinned environment for the TornadoVM CUDA demos.
#
# ---------------------------------------------------------------------------
# THE ONE LINE THAT SELECTS THE SDK
# ---------------------------------------------------------------------------
# Names a file in env/sdk/. `scripts/setup-env.sh` sources it and exports
# TORNADOVM_HOME, JAVA_HOME and the profile's capability flags. Override for a
# single shell by EXPORTING it before sourcing. See env/sdk/README.md.
#
#   sdkman-7.0.0   -- the released 7.0.0 CUDA SDK. HAS the CUDA Tile API (PR #1083
#                     is in the v7.0.0 tag), so it runs every demo. The default.
#   develop        -- source build of upstream develop; also has the tile API.
#                     Was the default before 7.0.0 shipped.
#   sdkman-6.0.0   -- the released 6.0.0 CUDA SDK; no tile API.
#
TORNADO_SDK_PROFILE=sdkman-7.0.0

# The default profile's pins, restated here for scripts/verify.sh and for provenance.
# env/sdk/sdkman-7.0.0.env is authoritative.
# Migrated: 2026-09-22 (modernization to the TornadoVM 7.0.0 CUDA release)
# Source of truth: results/raw/33-tornadovm-7-migration/*
#
# The demos no longer build TornadoVM from source. Everything below is
# installed with SDKMAN in two commands; see README.md "Quick install".

TORNADO_VERSION=7.0.0
TORNADO_SDKMAN_CANDIDATE=7.0.0-jdk22plus-cuda
TORNADO_BACKEND=cuda
TORNADO_RELEASE_COMMIT=65eb834
TORNADO_REMOTE=https://github.com/beehive-lab/TornadoVM.git
TORNADOVM_HOME=$HOME/.sdkman/candidates/tornadovm/7.0.0-jdk22plus-cuda
# NOTE: 7.0.0 ships two CUDA SDKs. `7.0.0-jdk21-cuda` is compiled with JDK 21 preview
# features and therefore runs on JDK 21 *only*. `7.0.0-jdk22plus-cuda` is the
# non-preview build (etc/tornado.jdk: floor=22, preview=false) and is the one this repo
# pins — it is the forward-looking SDK and removes the --enable-preview constraint that
# blocked JDK 23+ integrations under the earlier 5.2.1 pin.

JDK_SDKMAN_CANDIDATE=25.0.2-open
JDK_VERSION="openjdk 25.0.2 2026-01-20"
JAVA_HOME=$HOME/.sdkman/candidates/java/25.0.2-open
# NOTE: any JDK >= 22 satisfies the SDK's floor. JDK 27 removed JVMCI and the
# -XX:+EnableJVMCI flag entirely, so the generated argfile is JDK-specific:
# re-run `tornado --generate-argfile` after switching JDK.

GPU_NAME="NVIDIA GeForce RTX 4090"
GPU_DRIVER_VERSION=610.57.04
GPU_MEMORY_TOTAL_MIB=24564
GPU_COMPUTE_CAP=8.9
GPU_PCI_BUS_ID=00000000:01:00.0
NVIDIA_SMI_REPORTED_CUDA_VERSION=12.7

# --- CUDA 13 runtime required by the 7.0.0 CUTLASS bridge ---
# TornadoVM 7.0.0 ships `lib/libtornado-cutlass.so` linked against CUDA 13
# (`libcudart.so.13`). This box's toolkit is 12.6, so without a CUDA 13 runtime on the
# loader path demos 12, 17 and 18 die with
#   "Unable to load libtornado-cutlass. ... libcudart.so.13: cannot open shared object file".
# cuDNN conv2d/relu (demo 13) are unaffected: that path dlopens the system `libcudnn.so.9`
# and never loads `lib/libtornado-cudnn.so`. CuDnn.sdpaForward DOES load it, and it needs
# libnvrtc.so.13 AND GLIBC_2.38 -- unloadable on Ubuntu 22.04 (glibc 2.35). No demo uses SDPA.
# env/sdk/sdkman-7.0.0.env puts this directory on LD_LIBRARY_PATH (TORNADO_LD_LIBRARY_PATH).
# Evidence: results/raw/33-tornadovm-7-migration/{native-lib-ldd.log,run-all-demos-without-cuda13.log}
CUDA13_RUNTIME_LIB=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/lib
CUDA13_RUNTIME_SOURCE="pip nvidia-cu13 wheel (nvidia/cu13/lib)"

CUDA_TOOLKIT_NVCC_VERSION=12.6.85
CUDA_TOOLKIT_BUILD=cuda_12.6.r12.6/compiler.35059454_0
PTXAS_VERSION=12.6.85

GCC_VERSION="11.4.0 (Ubuntu 11.4.0-1ubuntu1~22.04)"
OS_PRETTY_NAME="Ubuntu 22.04.5 LTS"
KERNEL=6.8.0-58-generic

# --- Track B (GPULlama3.java): NOT migrated to 6.0.0 ---
# The GPULlama3.java demos (demos/09, demos/10) and every Track B measurement in
# results/ were captured against the previous source-built 5.2.1-jdk21-dev pin and are
# left untouched by the 6.0.0 migration. Their pins are kept below verbatim so the
# historical evidence under results/ stays interpretable. Do not read them as describing
# the current demo runtime.
GPULLAMA3_LEGACY_TORNADO_VERSION=5.2.1-jdk21-dev
GPULLAMA3_LEGACY_TORNADO_SHA=99549c9862eda8d584e35e99924f9c865501eb3a
GPULLAMA3_SHA=bbe42fdc8cd475bb6104cefa42118dd6e068538b
GPULLAMA3_BRANCH=main
GPULLAMA3_REMOTE=https://github.com/beehive-lab/GPULlama3.java.git
GPULLAMA3_COMMIT_DATE="2026-08-15 11:29:55 +0300"
GPULLAMA3_MODEL_USED=/home/michalis/test_install/GPULlama3.java/beehive-llama-3.2-1b-instruct-fp16.gguf
GPULLAMA3_MODEL_Q8_0=/home/michalis/llama3.java-tornadovm/Llama-3.2-1B-Instruct-Q8_0.gguf
GPULLAMA3_MODEL_Q4_0=/home/michalis/llama3.java-tornadovm/Llama-3.2-1B-Instruct-Q4_0.gguf
QUARKUS_LANGCHAIN4J_GPU_LLAMA3_VERSION=1.13.0
LANGCHAIN4J_GPU_LLAMA3_VERSION=1.19.0-beta29

# --- CUDA Tile: SUPERSEDED by env/sdk/develop.env (kept for provenance) -------
# PR #1083 is merged; the tile merge commit ec970e26d is an ancestor of upstream
# develop, so the tile demos no longer need the feat/cutile branch, JDK 21, or
# --enable-preview. The values below describe how batches 33 and 34 were captured
# (sm_89, driver 610.57.04, nvcc 13.3.73) and are kept so that evidence stays
# interpretable. Do not read them as the current runtime.
#
# --- CUDA Tile (demos 19, 20, 21) — a SEPARATE TornadoVM build, not the 6.0.0 pin ---
# The tile demos need the TileContext API, which does not exist in any released TornadoVM.
# They are built and run against a source build of the cuTile branch; everything else in
# this repo stays on the 6.0.0 SDK above. Captured 2026-09-11,
# evidence: results/raw/33-cutile-demos/.
CUTILE_TORNADO_VERSION=6.1.1-jdk21-dev
CUTILE_TORNADO_BRANCH=feat/cutile
CUTILE_TORNADO_PR=https://github.com/beehive-lab/TornadoVM/pull/1083
CUTILE_TORNADO_REMOTE=git@github.com:mikepapadim/TornadoVM.git
# The branch is a jdk21-dev build, so the demos compile with --release 21 --enable-preview
# and run on JDK 21, unlike the 6.0.0-jdk22plus-cuda SDK the other demos use.
CUTILE_JDK_SDKMAN_CANDIDATE=21.0.2-open
# CUDA Tile C++ needs toolkit 13.3+; this is a userspace pip install, no root:
#   pip install --user 'cuda-tile[tileiras]' nvidia-cuda-nvcc nvidia-cuda-cccl
# nvidia-cuda-cccl is required — without nv/target, cuda_fp16.h fails with
# __NV_IS_DEVICE undefined. Do NOT add -I/usr/local/cuda/include to work around it: the
# 12.6 host_defines.h overrides 13.3's __tile__.
CUTILE_NVCC_VERSION=13.3.73
CUTILE_NVCC_PATH=$HOME/.local/lib/python3.10/site-packages/nvidia/cu13/bin/nvcc
CUTILE_TILEIRAS_VERSION=13.3.36
# Driver R580+ is required to run a tile cubin at all (R610+ for the in-process NVRTC
# route, which this build does not use yet). The 565.57.01 recorded above could compile
# tile code but not load it; the box was upgraded for these demos.
CUTILE_GPU_DRIVER_VERSION=610.57.04
CUTILE_GPU_COMPUTE_CAP=8.9

# --- Second measurement host, added 2026-09-18 -------------------------------
# Batches 35+ were captured here. The GPU/driver/toolkit block above describes
# the sm_89 host and is unchanged; this is a different machine, and any timing
# comparison across the two is not single-variable.
SM120_GPU_NAME="NVIDIA GeForce RTX 5070 Ti"
SM120_GPU_DRIVER_VERSION=580.142
SM120_GPU_MEMORY_TOTAL_MIB=16303
SM120_GPU_COMPUTE_CAP=12.0
SM120_GPU_ARCH=sm_120
SM120_NVIDIA_SMI_REPORTED_CUDA_VERSION=13.0
# /usr/bin/nvcc is 12.0.140 and first on PATH; /usr/local/cuda is 13.0.88. Neither
# is new enough for the tile path, so a userspace 13.4 toolkit is pinned by
# TORNADO_NVCC in env/sdk/develop.env.
SM120_CUDA_TOOLKIT_SYSTEM_NVCC_VERSION=13.0.88
SM120_CUDA_TOOLKIT_TILE_NVCC_VERSION=13.4.92
SM120_CUDA_TOOLKIT_TILE_NVCC=$HOME/.local/lib/python3.11/site-packages/nvidia/cu13/bin/nvcc
SM120_GCC_VERSION="12.3.0 (Ubuntu 12.3.0-1ubuntu1~23.04)"
SM120_OS_PRETTY_NAME="Ubuntu 23.10 (Mantic Minotaur)"
SM120_KERNEL=6.5.0-44-generic
