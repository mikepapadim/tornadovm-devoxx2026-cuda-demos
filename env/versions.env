# Pinned environment for the TornadoVM CUDA demos — TornadoVM 6.0.0 (SDKMAN release)
# Migrated: 2026-09-02 (modernization to the TornadoVM 6.0.0 CUDA release)
# Source of truth: results/raw/18-tornadovm-6-migration/*
#
# The demos no longer build TornadoVM from source. Everything below is
# installed with SDKMAN in two commands; see README.md "Quick install".

TORNADO_VERSION=6.0.0
TORNADO_SDKMAN_CANDIDATE=6.0.0-jdk22plus-cuda
TORNADO_BACKEND=cuda
TORNADO_RELEASE_COMMIT=fadb20b
TORNADO_REMOTE=https://github.com/beehive-lab/TornadoVM.git
TORNADOVM_HOME=$HOME/.sdkman/candidates/tornadovm/6.0.0-jdk22plus-cuda
# NOTE: 6.0.0 ships two CUDA SDKs. `6.0.0-jdk21-cuda` is compiled with JDK 21 preview
# features and therefore runs on JDK 21 *only*. `6.0.0-jdk22plus-cuda` is the
# non-preview build (etc/tornado.jdk: floor=22, preview=false) and is the one this repo
# pins — it is the forward-looking SDK and removes the --enable-preview constraint that
# blocked JDK 23+ integrations under the previous 5.2.1 pin.

JDK_SDKMAN_CANDIDATE=25.0.2-open
JDK_VERSION="openjdk 25.0.2 2026-01-20"
JAVA_HOME=$HOME/.sdkman/candidates/java/25.0.2-open
# NOTE: any JDK >= 22 satisfies the SDK's floor. JDK 27 removed JVMCI and the
# -XX:+EnableJVMCI flag entirely, so the generated argfile is JDK-specific:
# re-run `tornado --generate-argfile` after switching JDK.

GPU_NAME="NVIDIA GeForce RTX 4090"
GPU_DRIVER_VERSION=565.57.01
GPU_MEMORY_TOTAL_MIB=24564
GPU_COMPUTE_CAP=8.9
GPU_PCI_BUS_ID=00000000:01:00.0
NVIDIA_SMI_REPORTED_CUDA_VERSION=12.7

CUDA_TOOLKIT_NVCC_VERSION=12.6.85
CUDA_TOOLKIT_BUILD=cuda_12.6.r12.6/compiler.35059454_0
PTXAS_VERSION=12.6.85

GCC_VERSION="11.4.0 (Ubuntu 11.4.0-1ubuntu1~22.04)"
OS_PRETTY_NAME="Ubuntu 22.04.5 LTS"
KERNEL=6.8.0-58-generic

# --- Track B (GPULlama3.java): NOT migrated to 6.0.0 ---
# The GPULlama3.java demos (demos/09, demos/10) and every Track B measurement in
# results/ were captured against the previous source-built 5.2.1-jdk21-dev pin and are
# left untouched by the 6.0.0 migration. Their pins are kept below verbatim so the
# historical evidence under results/ stays interpretable. Do not read them as describing
# the current demo runtime.
GPULLAMA3_LEGACY_TORNADO_VERSION=5.2.1-jdk21-dev
GPULLAMA3_LEGACY_TORNADO_SHA=99549c9862eda8d584e35e99924f9c865501eb3a
GPULLAMA3_SHA=bbe42fdc8cd475bb6104cefa42118dd6e068538b
GPULLAMA3_BRANCH=main
GPULLAMA3_REMOTE=https://github.com/beehive-lab/GPULlama3.java.git
GPULLAMA3_COMMIT_DATE="2026-08-15 11:29:55 +0300"
GPULLAMA3_MODEL_USED=/home/michalis/test_install/GPULlama3.java/beehive-llama-3.2-1b-instruct-fp16.gguf
GPULLAMA3_MODEL_Q8_0=/home/michalis/llama3.java-tornadovm/Llama-3.2-1B-Instruct-Q8_0.gguf
GPULLAMA3_MODEL_Q4_0=/home/michalis/llama3.java-tornadovm/Llama-3.2-1B-Instruct-Q4_0.gguf
QUARKUS_LANGCHAIN4J_GPU_LLAMA3_VERSION=1.13.0
LANGCHAIN4J_GPU_LLAMA3_VERSION=1.19.0-beta29
