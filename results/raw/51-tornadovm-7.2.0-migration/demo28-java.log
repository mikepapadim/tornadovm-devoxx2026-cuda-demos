    [1mthe kernel Qwen3-4B wrote for this prompt in rehearsal (--reference)[0m
      1 │ static void mandelbrot(int width, int height, int maxIterations, IntArray out) {
      2 │     for (@Parallel int y = 0; y < height; y++) {
      3 │         for (@Parallel int x = 0; x < width; x++) {
      4 │             float real = -2.2f + (x / (float) width) * 3.2f;
      5 │             float imag = -1.2f + (y / (float) height) * 2.4f;
      6 │             float zReal = 0.0f, zImag = 0.0f;
      7 │             int iter = 0;
      8 │             while (iter < maxIterations) {
      9 │                 float zReal2 = zReal * zReal - zImag * zImag + real;
     10 │                 float zImag2 = 2 * zReal * zImag + imag;
     11 │                 zReal = zReal2;
     12 │                 zImag = zImag2;
     13 │                 if (zReal * zReal + zImag * zImag > 4.0f) {
     14 │                     break;
     15 │                 }
     16 │                 iter++;
     17 │             }
     18 │             out.set(y * width + x, iter);
     19 │         }
     20 │     }
     21 │ }


